// Paste this into eraser.io → Diagram → Entity Relationship Diagram
// Focus: database-first model with frontend/backend usage context

erDiagram
    profiles {
        uuid id PK
        string full_name
        date date_of_birth
        string gender
        string city
        numeric annual_income
        numeric monthly_budget
        timestamptz created_at
    }

    assessment_sessions {
        uuid id PK
        uuid user_id FK
        int age
        numeric bmi
        boolean smoker
        numeric hba1c
        int bp_systolic
        boolean has_diabetes
        boolean has_hypertension
        int chronic_count
        string risk_tier
        numeric risk_score
        boolean vitals_deleted
        timestamptz created_at
    }

    recommendations {
        uuid id PK
        uuid user_id FK
        uuid session_id FK
        string risk_tier
        numeric risk_score
        jsonb top_plan_ids
        timestamptz created_at
    }

    saved_plans {
        uuid id PK
        uuid user_id FK
        string plan_id
        timestamptz saved_at
    }

    profiles ||--o{ assessment_sessions : "starts"
    profiles ||--o{ recommendations : "owns"
    profiles ||--o{ saved_plans : "bookmarks"
    assessment_sessions ||--o| recommendations : "produces"

// Frontend usage context
// - /login and /register create auth user + profile
// - /assessment writes assessment_sessions
// - /dashboard reads latest recommendations
// - /saved reads and toggles saved_plans
// - /profile updates profiles

